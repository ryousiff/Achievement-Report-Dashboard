DATABASE_URL="postgresql://kaan:change-me-before-production@localhost:5432/kaan_reports"
NEXTAUTH_SECRET="replace-with-a-long-random-value"
NEXTAUTH_URL="http://localhost:3000"
META_APP_ID=""
META_APP_SECRET=""
META_TOKEN_ENCRYPTION_KEY="replace-with-a-long-random-value"
META_REDIRECT_URI="http://localhost:3000/api/connectors/meta/callback"
# Optional: Facebook Login for Business configuration ID (App dashboard > Facebook Login for Business >
# Configurations). Only usable for EXTERNAL client businesses that are separate from the business that
# owns this app; Meta blocks selecting your own app's business portfolio here (see META_BUSINESS_ID below).
META_LOGIN_CONFIG_ID=""
# Business Manager ID that owns this app's own Pages/Instagram accounts (e.g. Kaan Creative). Used only by
# the admin-only "connect via system-user token" flow (see src/lib/meta.ts fetchBusinessManagedPages),
# which discovers Pages/Instagram/ad accounts through the Business Manager API instead of Facebook Login,
# because an app can't use Login for Business to onboard the same business that owns the app.
META_BUSINESS_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/connectors/google/callback"
GOOGLE_SIGNIN_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
GOOGLE_WORKSPACE_DOMAIN="kaancreative.com"
GOOGLE_SHARED_DRIVE_ID="0AFYGZxrwqdtTUk9PVA"
GOOGLE_TOKEN_ENCRYPTION_KEY="replace-with-a-long-random-value"
# Historical Instagram backfill (see src/lib/backfill-window.ts and src/lib/meta-sync.ts)
HISTORICAL_BACKFILL_MONTHS="15"
HISTORICAL_BACKFILL_POSTS_PER_RUN="25"
HISTORICAL_BACKFILL_API_CALL_BUDGET="150"
HISTORICAL_BACKFILL_MAX_RUNTIME_MS="20000"
ACCOUNT_INSIGHT_CHUNK_DAYS="30"
ACCOUNT_INSIGHT_MAX_LOOKBACK_DAYS="450"
RECENT_POST_REFRESH_DAYS="60"
COLLABORATIVE_RECONCILIATION_DAYS="60"
SYNC_MAX_RETRIES="5"
SYNC_RETRY_BASE_DELAY_MS="30000"
# Minimum spacing (ms) between consecutive Meta Graph API calls within one worker process.
# Higher values stay under Meta's application rate limit; 500 is a conservative default.
META_SYNC_MIN_INTERVAL_MS="500"
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/connectors/tiktok/callback"

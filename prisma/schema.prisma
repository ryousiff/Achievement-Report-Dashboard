generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
  YOUTUBE
  X
}

enum ReportStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  EXPORTED
}

enum BlockType {
  TEXT
  KPI
  CHART
  PLATFORM_ANALYTICS
  MEDIA
  NOTES
  RECOMMENDATIONS
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  reports      Report[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Client {
  id          String              @id @default(cuid())
  name        String
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  connections SocialConnection[]
  reports     Report[]
}

model MetaProfile {
  id            String        @id @default(cuid())
  displayName   String
  createdById   String
  tokenExpiresAt DateTime?
  lastSyncedAt  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accounts      MetaAccount[]

  @@index([createdById])
}

model MetaAccount {
  id                String        @id @default(cuid())
  profileId         String
  platform          Platform
  externalAccountId String
  displayName       String
  encryptedToken    String
  tokenExpiresAt    DateTime?
  lastSyncedAt      DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  profile           MetaProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assignments       SocialConnection[]

  @@unique([profileId, platform, externalAccountId])
  @@index([platform, externalAccountId])
}

model SocialConnection {
  id               String        @id @default(cuid())
  clientId         String
  sourceAccountId  String?
  platform         Platform
  externalAccountId String
  displayName      String
  encryptedToken   String
  tokenExpiresAt   DateTime?
  lastSyncedAt     DateTime?
  createdAt        DateTime      @default(now())
  client           Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sourceAccount    MetaAccount?  @relation(fields: [sourceAccountId], references: [id], onDelete: SetNull)
  posts            SocialPost[]
  insightSnapshots SocialInsightSnapshot[]

  @@unique([clientId, platform, externalAccountId])
  @@index([sourceAccountId])
}

model SocialPost {
  id             String   @id @default(cuid())
  connectionId   String
  externalPostId String
  caption        String?
  mediaType      String
  mediaUrl       String?
  thumbnailUrl   String?
  permalink      String?
  publishedAt    DateTime
  metrics        Json
  syncedAt       DateTime @updatedAt
  connection     SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalPostId])
  @@index([connectionId, publishedAt])
}

model SocialInsightSnapshot {
  id           String   @id @default(cuid())
  connectionId String
  metric       String
  periodStart  DateTime
  periodEnd    DateTime
  value        Float
  capturedAt   DateTime @default(now())
  connection   SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, metric, periodStart, periodEnd])
  @@index([connectionId, periodStart, periodEnd])
}

model Report {
  id          String       @id @default(cuid())
  clientId    String
  createdById String
  title       String
  periodStart DateTime
  periodEnd   DateTime
  status      ReportStatus @default(DRAFT)
  isBlank     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy   User         @relation(fields: [createdById], references: [id])
  blocks      ReportBlock[]
}

model ReportBlock {
  id        String    @id @default(cuid())
  reportId  String
  type      BlockType
  position  Int
  content   Json
  report    Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, position])
}

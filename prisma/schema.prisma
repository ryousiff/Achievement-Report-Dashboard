generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
  YOUTUBE
  X
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum ReportStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  EXPORTED
}

enum BlockType {
  TEXT
  KPI
  CHART
  PLATFORM_ANALYTICS
  MEDIA
  NOTES
  RECOMMENDATIONS
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum SyncRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum SyncJobType {
  INCREMENTAL_MEDIA_SYNC
  HISTORICAL_MEDIA_BACKFILL
  HISTORICAL_COLLABORATIVE_BACKFILL
  RECENT_POST_INSIGHT_REFRESH
  DAILY_ACCOUNT_INSIGHT_SYNC
  STORY_SYNC
}

enum BackfillStatus {
  NOT_STARTED
  RUNNING
  PARTIAL
  COMPLETED
  FAILED
}

enum MediaSource {
  OWNED
  COLLABORATIVE
}

enum InsightPeriodType {
  DAY
  WEEK
  DAYS_28
  TOTAL_VALUE
}

model User {
  id                     String     @id @default(cuid())
  email                  String     @unique
  name                   String?
  passwordHash           String?
  role                   Role       @default(EDITOR)
  googleRefreshToken     String?
  googleTokenExpiresAt   DateTime?
  googleSubject          String?    @unique
  googleEmail            String?
  googleWorkspaceDomain  String?
  googleIdentityLinkedAt DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  reports                Report[]
  sessions               Session[]
  auditLogs              AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Client {
  id            String             @id @default(cuid())
  name          String
  logoUrl       String?
  driveFolderId String?
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  connections   SocialConnection[]
  reports       Report[]
}

model MetaProfile {
  id             String        @id @default(cuid())
  displayName    String
  createdById    String
  tokenExpiresAt DateTime?
  lastSyncedAt   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  accounts       MetaAccount[]

  @@index([createdById])
}

model MetaAccount {
  id                String             @id @default(cuid())
  profileId         String
  platform          Platform
  externalAccountId String
  displayName       String
  encryptedToken    String
  tokenExpiresAt    DateTime?
  lastSyncedAt      DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  profile           MetaProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assignments       SocialConnection[]

  @@unique([profileId, platform, externalAccountId])
  @@index([platform, externalAccountId])
}

model SocialConnection {
  id                   String    @id @default(cuid())
  clientId             String
  sourceAccountId      String?
  platform             Platform
  externalAccountId    String
  displayName          String
  encryptedToken       String
  tokenExpiresAt       DateTime?
  lastSyncedAt         DateTime?
  lastSuccessfulSyncAt DateTime?
  lastFailedSyncAt     DateTime?
  lastFailureReason    String?
  syncLockedUntil      DateTime?
  createdAt            DateTime  @default(now())

  // Historical backfill state (separate from incremental sync above; see lastIncrementalSyncAt/lastIncrementalSyncError)
  historicalBackfillStatus         BackfillStatus @default(NOT_STARTED)
  historicalBackfillStart          DateTime?
  historicalBackfillCursor         String?
  historicalBackfillPageIndex      Int?
  historicalBackfillStartedAt      DateTime?
  historicalBackfillCompletedAt    DateTime?
  historicalBackfillLastError      String?
  historicalBackfillRetryCount     Int            @default(0)
  historicalBackfillProcessedPosts Int            @default(0)

  // Collaborative media backfill state (mirrors the owned backfill above)
  collaborativeBackfillStatus         BackfillStatus @default(NOT_STARTED)
  collaborativeBackfillStart          DateTime?
  collaborativeBackfillCursor         String?
  collaborativeBackfillPageIndex      Int            @default(0)
  collaborativeBackfillStartedAt      DateTime?
  collaborativeBackfillCompletedAt    DateTime?
  collaborativeBackfillLastError      String?
  collaborativeBackfillRetryCount     Int            @default(0)
  collaborativeBackfillProcessedPosts Int            @default(0)

  // Incremental sync state, distinct from the historical backfill above
  lastIncrementalSyncAt    DateTime?
  lastIncrementalSyncError String?

  // Account-level insight coverage.
  // reachCoverageStart / reachWeekCoverageStart / reachDays28CoverageStart are the earliest periodEnd for which we have
  // a daily / 7-day / 28-day reach snapshot.
  reachCoverageStart                 DateTime?
  reachWeekCoverageStart             DateTime?
  reachDays28CoverageStart           DateTime?
  followerCountCoverageStart         DateTime?
  accountInsightsLastSyncedAt        DateTime?
  accountInsightsBackfillCompletedAt DateTime?
  accountInsightsLastError           String?

  // Stories placeholder (Part 4) — no sync pipeline exists yet, field reserved for future use
  storyCoverageStart DateTime?

  client           Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sourceAccount    MetaAccount?            @relation(fields: [sourceAccountId], references: [id], onDelete: SetNull)
  posts            SocialPost[]
  insightSnapshots SocialInsightSnapshot[]
  syncJobs         SyncJob[]
  syncRuns         SyncRun[]

  @@unique([clientId, platform, externalAccountId])
  @@index([sourceAccountId])
}

model SocialPost {
  id                      String           @id @default(cuid())
  connectionId            String
  externalPostId          String
  caption                 String?
  mediaType               String
  mediaUrl                String?
  thumbnailUrl            String?
  permalink               String?
  publishedAt             DateTime
  mediaSource             MediaSource @default(OWNED)
  mediaMetadata           Json?
  metrics                 Json
  metricAvailability      Json?
  metricAvailabilityState Json?
  lastInsightRefreshAt    DateTime?
  syncedAt                DateTime         @updatedAt
  connection              SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalPostId])
  @@index([connectionId, publishedAt])
}

model SocialInsightSnapshot {
  id           String            @id @default(cuid())
  connectionId String
  metric       String
  periodType   InsightPeriodType @default(DAY)
  periodStart  DateTime
  periodEnd    DateTime
  value        Float
  capturedAt   DateTime          @default(now())
  connection   SocialConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, metric, periodType, periodStart, periodEnd])
  @@index([connectionId, periodType, periodStart, periodEnd])
}

model SyncJob {
  id           String           @id @default(cuid())
  connectionId String
  type         SyncJobType      @default(INCREMENTAL_MEDIA_SYNC)
  status       SyncJobStatus    @default(QUEUED)
  attempts     Int              @default(0)
  maxAttempts  Int              @default(5)
  runAfter     DateTime         @default(now())
  lockedAt     DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  lastError    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  connection   SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  runs         SyncRun[]

  @@index([status, runAfter])
  @@index([connectionId, type, status])
}

model SyncRun {
  id           String           @id @default(cuid())
  jobId        String
  connectionId String
  status       SyncRunStatus    @default(RUNNING)
  startedAt    DateTime         @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  postsSynced  Int              @default(0)
  errorCode    String?
  errorMessage String?
  createdAt    DateTime         @default(now())
  job          SyncJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  connection   SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@index([jobId])
}

model Report {
  id                     String          @id @default(cuid())
  clientId               String
  createdById            String
  title                  String
  periodStart            DateTime
  periodEnd              DateTime
  status                 ReportStatus    @default(DRAFT)
  isBlank                Boolean         @default(false)
  orientation            String          @default("landscape")
  approvalOverrideReason String?
  // Set whenever refreshReportData() (src/lib/report-refresh.ts) recomputes this report's
  // data-driven blocks from the database. Used to show "last refreshed" and to avoid
  // redundant Meta API calls when export/refresh is triggered again shortly after.
  dataRefreshedAt        DateTime?
  coverageStatus         String?
  coverageWarnings       Json?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  client                 Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy              User            @relation(fields: [createdById], references: [id])
  blocks                 ReportBlock[]
  versions               ReportVersion[]
  exports                ReportExport[]
}

model ReportVersion {
  id        String   @id @default(cuid())
  reportId  String
  number    Int
  snapshot  Json
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, number])
  @@index([reportId, createdAt])
}

model ReportExport {
  id          String   @id @default(cuid())
  reportId    String
  orientation String
  status      String   @default("EXPORTED")
  fileUrl     String?
  createdAt   DateTime @default(now())
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
}

model ReportBlock {
  id       String    @id @default(cuid())
  reportId String
  type     BlockType
  position Int
  content  Json
  report   Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, position])
}

model Setting {
  id        String   @id @default(cuid())
  moduleId  String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, key])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([resource, resourceId])
  @@index([createdAt])
}
